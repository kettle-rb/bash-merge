# Ignore built gem artifacts and package dir
bin/**/*
certs/**/*
checksums/**/*
gemfiles/**/*
pkg/**/*
spec/**/*
spec*/**/*
test/**/*
tmp/**/*
# Ignore tmp directory except for yard-fence (which is explicitly included in .yardopts)
tmp/archive/**/*
tmp/*.txt
tmp/*.rb
*.gem
# Also ignore yardoc cache
.yardoc/
